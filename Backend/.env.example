# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sorax

# ── AI / External APIs ────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
GMAIL_IMAP_USER=your-email@gmail.com
GMAIL_IMAP_PASSWORD=your-app-password
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-password

# ── Auth (JWT) ────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ── Admin Seed (used only by create_owner CLI) ────────────
# These are NEVER read by application code at runtime.
# Only used once by `python -m src.scripts.create_owner`
OWNER_EMAIL=admin@company.com
OWNER_PASSWORD=change-this-password
OWNER_NAME=System Owner

# ── Project ───────────────────────────────────────────────
PROJECT_NAME=Sorax Automation
DEBUG=false
APPROVED_CLIENT_SENDERS=approved@example.com,client@example.com
